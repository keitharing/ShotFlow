  "output": {"node_title": "SF:출력", "kind": "image"},
  "bindings": {
    "crop_image": {"node_title": "SF:수정 영역", "input": "image"},
    "crop_mask": {"node_title": "SF:마스크", "input": "image"}
  },
  "expose": {
    "SF:샘플러": ["seed", "steps", "cfg", "denoise"],
    "SF:수정 영역": [],
    "SF:마스크": [],
    "SF:마스크 확장": ["expand"]
  },
  "strength_input": {"node_title": "SF:샘플러", "input": "denoise"},
  "fix_work_size": 512
}
