{
  "id": "guide_depth_sd15",
  "name": "3D 가이드 키프레임",
  "kind": "guide",
  "description": "Blender로 잡은 장면을 사진처럼 다시 그립니다. Blender 렌더를 바탕으로 깊이 이미지로 구도를 고정하고, 사진풍 SD1.5 모델(Realistic Vision 6.0)이 질감과 빛을 다시 그린 뒤 1.5배로 키워 한 번 더 다듬습니다 (1536×864).",
  "output": {"node_title": "SF:출력", "kind": "image"},
  "bindings": {
    "source_image": {"node_title": "SF:3D 렌더", "input": "image"},
    "guide_depth": {"node_title": "SF:깊이 이미지", "input": "image"}
  },
  "expose": {
    "SF:프롬프트": ["text"],
    "SF:네거티브": ["text"],
    "SF:구도 고정": ["strength", "end_percent"],
    "SF:샘플러": ["seed", "steps", "cfg", "denoise"],
    "SF:다듬기": ["seed", "denoise"],
    "SF:작업 해상도": ["width", "height"],
    "SF:3D 렌더": [],
    "SF:깊이 이미지": []
  },
  "size_inputs": [{"node_title": "SF:작업 해상도", "width": "width", "height": "height"}],
  "strength_input": {"node_title": "SF:샘플러", "input": "denoise"},
  "limits": {"multiple": 8, "max_area": 655360, "length_min": 0, "length_max": 0}
}
